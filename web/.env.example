# Copy to .env.local for a cloud-mode build. Values are public web config, not secrets.
VITE_FIREAI_MODE=cloud
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fireai-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fireai-dev
VITE_FIREBASE_DATABASE_URL=https://fireai-dev-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=fireai-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Set to 1 to point the SDK at the local emulator suite
VITE_FIREBASE_EMULATORS=0
